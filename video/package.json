{
  "name": "cloud-sage-video",
  "version": "1.0.0",
  "description": "Cloud Sage mascot: waving clip + stills for the profile SVGs",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:wave": "remotion render Wave out/cloud-sage-wave.mp4",
    "render:stills": "remotion still Portrait out/portrait.png && remotion still Point out/point.png",
    "frames": "ffmpeg -y -i out/cloud-sage-wave.mp4 -vf fps=15,scale=320:320 -q:v 5 ../assets/character/frames/f%02d.jpg"
  },
  "allowScripts": {
    "esbuild": false
  }
}
